# Database（内嵌 H2，无需安装 MySQL；删除项目下 data 目录即可重置演示数据）
SHOP_DB_URL=jdbc:h2:file:./data/shop;MODE=MySQL
SHOP_DB_USERNAME=sa
SHOP_DB_PASSWORD=
SHOP_JPA_DDL_AUTO=update
SHOP_JPA_SHOW_SQL=true

# Application
SERVER_PORT=9800
# 静态资源基地址：默认指向应用自身（商品图/轮播图已内置在 static/goods、static/banners）
SHOP_ASSET_BASE_URL=http://localhost:9800/
SHOP_LOG_PATH=logs

# Optional Alipay sandbox settings
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
